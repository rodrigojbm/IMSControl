{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da vela"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "size": {
      "type": "string",
      "enum": [
        "pequena",
        "media",
        "grande",
        "especial"
