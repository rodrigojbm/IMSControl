      "type": "number",
      "description": "Pre\u00e7o de venda"
    },
    "recipe": {
      "type": "array",
      "description": "Receita/insumos necess\u00e1rios",
      "items": {
        "type": "object",
        "properties": {
          "supply_id": {
            "type": "string"
          },
          "supply_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "image_url": {
      "type": "string",
      "description": "Foto do produto"
    }
  },
  "required": [
